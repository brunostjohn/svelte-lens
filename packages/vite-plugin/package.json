{
  "name": "svelte-lens-vite",
  "version": "0.1.0",
  "description": "Development-only Vite instrumentation for the Svelte Lens Chrome DevTools extension.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "brunoreintersect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunostjohn/svelte-lens.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/brunostjohn/svelte-lens#readme",
  "bugs": {
    "url": "https://github.com/brunostjohn/svelte-lens/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "vite",
    "devtools",
    "chrome-extension",
    "debugging"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run test"
  },
  "dependencies": {
    "magic-string": "^0.30.17"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "svelte": "^5.56.9",
    "vite": "^7.3.2"
  }
}
