{
  "name": "svelte-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm --filter svelte-lens-vite build && pnpm --filter @svelte-lens/extension build && pnpm --filter @svelte-lens/playground build",
    "build:extension": "pnpm --filter @svelte-lens/extension build",
    "check": "pnpm --filter svelte-lens-vite build && pnpm -r check",
    "dev": "pnpm --filter svelte-lens-vite build && pnpm --filter @svelte-lens/playground dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
